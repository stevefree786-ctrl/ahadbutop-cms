# Copy to .env and fill in. NEVER commit .env itself.
#   cp .env.example .env

APP_ENV=development
APP_DEBUG=true
# Absolute base URL. Used to build canonical links, sitemaps, og:url and the
# permalinks the SocialAgent hands you. Without it those come out hostless.
APP_URL=http://localhost:8080

# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Rotating this invalidates every issued token, so treat it as stable per install.
JWT_SECRET=
# Token lifetime in seconds. 3600 = 1 hour.
JWT_TTL=3600

DB_CONNECTION=sqlite

# --- AI agents (BYOK) ------------------------------------------------------
# Both are optional. Leave blank to run the CMS with no AI: every agent that
# needs a model returns a clear "no provider configured" error instead of
# failing the request.
#
# Kilo: https://kilo.ai  ->  free tier is rate-limited per hour, so the fleet
# treats it as the primary and falls back to Zen.
KILO_API_KEY=
# OpenCode Zen, used as the automatic failover when Kilo rate-limits.
OPENCODE_ZEN_KEY=

# --- BYOK encryption --------------------------------------------------------
# The key that encrypts provider keys typed into Settings → AI providers.
#
# Generate with: php -r "echo bin2hex(random_bytes(32));"
#
# Optional, but WITHOUT it the BYOK screen refuses to save: BYOK values are
# encrypted at rest, and there is deliberately no plaintext fallback. Operators
# who only set KILO_API_KEY above never need this.
#
# Changing it later makes every previously-stored provider key unreadable.
# ProviderKeyStore falls back to the .env keys and logs a warning rather than
# failing loudly, so the site keeps working — but the stored keys must be
# re-entered. Keep it stable, and keep it out of version control.
CMS_ENCRYPTION_KEY=

# Comma-separated allowed origins, or * for any. Narrow this in production.
CORS_ALLOWED_ORIGINS=*